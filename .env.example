# Copy to .env and fill in your own Supabase project values.
# The publishable key is public by design (it ships in the browser bundle).
# The service role key is SECRET — server side only, never in the browser code.

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

SUPABASE_PROJECT_ID="YOUR-PROJECT"

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"
